+# ---- OPT mode: throughput-optimal batch depth --------------------------------------------------------------------
+# tokens/step at batch depth d  =  n + sum_i sum_{k<=d} P_i(accepted >= k)
+# step time                     ~  T0(n) * (1 + cost(n) * d)        (cost(n): measured on this box, see the config)
+# d* = argmax over [min, K] of their ratio. P_i comes from an EWMA over the positions request i actually drafted,
+# shrunk toward a population prior (a new request starts from the population, not from depth 3). Every `probe`
+# steps the batch drafts two positions deeper than d* so the deep estimates stay fresh. No host sync: the GPU writes
+# the rate table to pinned memory, the next poll reads it.
+def _opt_observe(idx_mapping, num_sampled, num_rejected):
+    rows = idx_mapping.long()
+    acc = (num_sampled.to(torch.int32) - 1).clamp(min=0)
+    drafted = acc + num_rejected.to(torch.int32)                       # drafts verified this step, per request
+    obs = (D.pos[None, :] <= drafted[:, None]).to(torch.float32)        # [B, K] positions that were drafted
+    hit = ((acc[:, None] >= D.pos[None, :]).to(torch.float32)) * obs
+    lam = 1.0 - 1.0 / D.horizon
+    dec = 1.0 - obs * (1.0 - lam)                                       # decay observed positions only
+    D.num[rows] = D.num[rows] * dec + hit
+    D.den[rows] = D.den[rows] * dec + obs
+    a = 0.01                                                            # population prior: slow EWMA of counts
+    D.pop_num.mul_(1.0 - a).add_(a * hit.sum(0))
+    D.pop_den.mul_(1.0 - a).add_(a * obs.sum(0))
+    if D.steps % _POLL == 0 and not D.opt_pending:
+        D.opt_rate.copy_(_opt_rates(), non_blocking=True)
+        D.opt_ev.record()
+        D.opt_pending = True
+        D.opt_snap_gen = list(D.opt_gen)
+
+
+def _opt_rates():
+    """[R+1, K] estimates of P(accepted >= k); the last row is the population curve (for rows reset since).
+
+    Each position blends the request's own EWMA with an extrapolation: the request's previous position times its
+    last conditional acceptance (geometric continuation), itself blended with the population curve by how much the
+    request has observed. A position the batch has not drafted lately is thus estimated from the request's own
+    curve, not pinned to a conservative prior (which would keep the depth shallow and starve the deep positions).
+    """
+    pop = (D.pop_num / D.pop_den.clamp(min=1e-6)).clamp(0.0, 1.0)
+    num, den = D.num, D.den
+    R, K = num.shape
+    one = torch.ones(R, device=num.device)
+    r_prev2, r_prev = one, one
+    cols = []
+    for k in range(K):
+        if k == 0:
+            ext = pop[0].expand(R)
+        else:
+            geo = r_prev * (r_prev / r_prev2.clamp(min=1e-3)).clamp(0.0, 1.0)
+            w = den[:, k - 1] / (den[:, k - 1] + 4.0)
+            ext = w * geo + (1.0 - w) * pop[k]
+        r = (num[:, k] + 2.0 * ext) / (den[:, k] + 2.0)
+        r = torch.minimum(r, r_prev)
+        cols.append(r)
+        r_prev2, r_prev = r_prev, r
+    rate = torch.stack(cols, 1)
+    popc = torch.cummin(pop, 0).values
+    return torch.cat([rate, popc[None, :]], 0)
+
+
+def _opt_time_d(pts, d):
+    if d <= pts[0][0]:
+        (a, ta), (b, tb) = pts[0], pts[1]
+    elif d >= pts[-1][0]:
+        (a, ta), (b, tb) = pts[-2], pts[-1]
+    else:
+        for (a, ta), (b, tb) in zip(pts, pts[1:]):
+            if d <= b:
+                break
+    return ta + (tb - ta) * (d - a) / (b - a)
+
+
+def _opt_time(n, d):
+    """Relative step time at n running requests and batch depth d (interpolated from D.steptime)."""
+    tab = D.steptime
+    if n <= tab[0][0]:
+        return _opt_time_d(tab[0][1], d)
+    for (na, pa), (nb, pb) in zip(tab, tab[1:]):
+        if n <= nb:
+            w = (n - na) / (nb - na)
+            return (1 - w) * _opt_time_d(pa, d) + w * _opt_time_d(pb, d)
+    return _opt_time_d(tab[-1][1], d)
+
+
+def _opt_decide():
+    """Batch depth for the next propose: d* from the latest rate snapshot (no sync), or a probe two deeper."""
+    if D.opt_pending and D.opt_ev.query():
+        D.opt_pending = False
+        live = D.opt_live
+        if live:
+            rate = D.opt_rate
+            gens = D.opt_snap_gen
+            prior = rate[D.R].tolist()
+            n = len(live)
+            cum = [0.0] * (D.K + 1)
+            for i in live:
+                row = prior if gens is None or gens[i] != D.opt_gen[i] else rate[i].tolist()
+                run = 0.0
+                for k in range(D.K):
+                    run += row[k]
+                    cum[k + 1] += run
+            best, bd = -1.0, D.K
+            for d in range(D.dmin, D.K + 1):
+                v = (n + cum[d]) / _opt_time(n, d)
+                if v > best:
+                    best, bd = v, d
+            D.opt_d = bd
+            if D.log:
+                log.info("mbx depth opt · %d running · depth %d · expected tokens/req/step %.2f · cum %s · prior %s",
+                         n, bd, (n + cum[bd]) / n, [round(x / n, 2) for x in cum[1:]], [round(x, 2) for x in prior])
+    if D.probe and D.steps % D.probe == D.probe - 1:
+        return D.K                                                      # probe: draft every position
+    return D.opt_d
